        <mxCell id="docker" value="Docker Compose" style="text;html=1;align=center;fontSize=12;fontStyle=1;fontFamily=Times New Roman;fillColor=#F5F5F5;strokeColor=#9E9E9E;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="400" width="200" height="30" as="geometry" />
