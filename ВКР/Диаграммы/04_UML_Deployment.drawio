        <mxCell id="e2" value="HTTP/WS" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;fontSize=10;fontFamily=Times New Roman;" edge="1" parent="1" source="nginx" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="SQL (Prisma)" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#333333;fontSize=10;fontFamily=Times New Roman;" edge="1" parent="1" source="backend" target="postgres"><mxGeometry relative="1" as="geometry" /></mxCell>
